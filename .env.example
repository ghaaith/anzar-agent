# Database
DATABASE_URL=postgresql://anzar:password@localhost:5432/anzar

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Workspace limits
DEFAULT_WORKSPACE_LIMIT_MB=500
PRO_WORKSPACE_LIMIT_MB=2048
TEAM_WORKSPACE_LIMIT_MB=5120

# Docker sandbox
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=anzar-sandbox:latest
IDLE_TIMEOUT_MINUTES=30
HEALTH_CHECK_INTERVAL=60

# LLM Provider (for CLI mode - server mode reads from DB settings)
# Default: OpenRouter (free Qwen3 Coder)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Debug
DEBUG=false
